diff --git a/src/agent.ts b/src/agent.ts
index 0a03ef02807b89dee87b80033c1e23fe5f7c8a70..d31be969f722fb7c9923b52a0919f01509e6f62d 100644
--- a/src/agent.ts
+++ b/src/agent.ts
@@ -758,6 +758,28 @@ export class Agent {
 		return this.#followUpQueue.pop();
 	}
 
+
+	/**
+	 * Remove and return a steering message by queue index.
+	 */
+	removeSteer(index: number): AgentMessage | undefined {
+		if (!Number.isInteger(index) || index < 0 || index >= this.#steeringQueue.length) {
+			return undefined;
+		}
+		const [removed] = this.#steeringQueue.splice(index, 1);
+		return removed;
+	}
+
+	/**
+	 * Remove and return a follow-up message by queue index.
+	 */
+	removeFollowUp(index: number): AgentMessage | undefined {
+		if (!Number.isInteger(index) || index < 0 || index >= this.#followUpQueue.length) {
+			return undefined;
+		}
+		const [removed] = this.#followUpQueue.splice(index, 1);
+		return removed;
+	}
 	clearMessages() {
 		this.#state.messages.length = 0;
 	}
