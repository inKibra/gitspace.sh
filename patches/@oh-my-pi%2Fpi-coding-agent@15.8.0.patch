+		if (this.#steeringMessages.length > 0) {
+			this.#steeringMessages = [];
+			this.agent.clearSteeringQueue();
+		}
 		const displayText = text || (images && images.length > 0 ? "[Image]" : "");
 		this.#steeringMessages.push({ text: displayText });
