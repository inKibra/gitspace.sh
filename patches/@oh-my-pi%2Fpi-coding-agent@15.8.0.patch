+	/** Remove a queued message by visible kind and index. */
+	removeQueuedMessage(kind: "steering" | "followUp", index: number): string | undefined {
+		const queue = kind === "steering" ? this.#steeringMessages : this.#followUpMessages;
+		if (!Number.isInteger(index) || index < 0 || index >= queue.length) {
+			return undefined;
+		}
+		const [message] = queue.splice(index, 1);
+		if (kind === "steering") {
+			this.agent.removeSteer?.(index) ?? this.agent.popLastSteer();
+		} else {
+			this.agent.removeFollowUp?.(index) ?? this.agent.popLastFollowUp();
+		}
+		return message?.text;
+	}
