+const streamingParsedLengths = new WeakMap();
+/**
+ * GitSpace: a streaming tool call's arguments, parsed again only once its JSON grew by a quarter (at least 512
+ * characters) since the block's last parse; until then the arguments the block already holds. Parsing the whole string
+ * on every delta costs time quadratic in its length: a tool call writing a 330 KB file took 45 s of CPU, past a
+ * Worker's limit. A block's final arguments come from its full parse when it ends.
+ */
+export function parseStreamingJsonDelta(block, partialJson) {
+    const parsed = streamingParsedLengths.get(block);
+    if (parsed !== undefined && partialJson.length < parsed + Math.max(512, parsed / 4))
+        return block.arguments;
+    streamingParsedLengths.set(block, partialJson.length);
