diff --git a/src/agent.ts b/src/agent.ts
index 2e2b6e872c1f0685306f137fb58df6da412fc5dc..0c0405aab4f0b6a4f638e24d7b8b4922b73a7648 100644
--- a/src/agent.ts
+++ b/src/agent.ts
@@ -885,6 +885,20 @@ export class Agent {
 		this.#followUpQueue = [];
 	}
 
+	/** Remove and return a steering message by queue index (GitSpace patch). */
+	removeSteer(index: number): AgentMessage | undefined {
+		if (!Number.isInteger(index) || index < 0 || index >= this.#steeringQueue.length) return undefined;
+		const [removed] = this.#steeringQueue.splice(index, 1);
+		return removed;
+	}
+
+	/** Remove and return a follow-up message by queue index (GitSpace patch). */
+	removeFollowUp(index: number): AgentMessage | undefined {
+		if (!Number.isInteger(index) || index < 0 || index >= this.#followUpQueue.length) return undefined;
+		const [removed] = this.#followUpQueue.splice(index, 1);
+		return removed;
+	}
+
 	hasQueuedMessages(): boolean {
 		return this.#steeringQueue.length > 0 || this.#followUpQueue.length > 0;
 	}
