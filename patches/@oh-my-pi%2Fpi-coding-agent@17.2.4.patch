+	// Every role the operator can see under settings > Models > model roles:
+	// non-hidden built-ins PLUS custom roles introduced via cycleOrder,
+	// modelRoles or modelTags. Deliberately NOT limited to roles that already
+	// have a model bound, nor to the quick-cycle subset — an agent may name any
+	// role the operator has, bound or not.
+	const knownRoles = settings ? getKnownRoleIds(settings) : (MODEL_ROLE_IDS as string[]);
