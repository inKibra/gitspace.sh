+ * also serves human surfaces (the agent dashboard) and agent-definition
+ * frontmatter, where naming a concrete model is legitimate. This guard is for
+ * the agent-facing spawn path only.
+ *
+ * `undefined` is allowed — it means "inherit", which is the desired default.
+ */
+export function assertRoleOnlyModelSelector(value: string | string[] | undefined, settings?: Settings): void {
+	const patterns = normalizeModelPatternList(value);
+	if (patterns.length === 0) return;
