+/// Classify opaque connector/TLS errors without ever copying their text into
+/// diagnostics. Only inspect a bounded prefix; unknown wording stays redacted.
+fn safe_transport_label(error: &(dyn std::error::Error + 'static)) -> &'static str {
+    use std::fmt::Write;
+    struct Prefix(String);
+    impl std::fmt::Write for Prefix {
+        fn write_str(&mut self, text: &str) -> std::fmt::Result {
+            let mut end = text.len().min(512 - self.0.len());
+            while !text.is_char_boundary(end) {
+                end -= 1;
+            }
+            self.0.push_str(&text[..end]);
+            if end < text.len() {
+                Err(std::fmt::Error)
+            } else {
+                Ok(())
+            }
+        }
+    }
+    let mut prefix = Prefix(String::new());
+    let _ = write!(prefix, "{error}");
+    prefix.0.make_ascii_lowercase();
+    let text = prefix.0.as_str();
+    if [
+        "bad record mac",
+        "badrecordmac",
+        "decrypt error",
+        "decrypterror",
+        "cannot decrypt peer's message",
+    ]
+    .iter()
+    .any(|phrase| text.contains(phrase))
+    {
+        "tls_decrypt_or_bad_record_mac"
+    } else if [
+        "invalid peer certificate",
+        "invalid certificate",
+        "certificate verify failed",
+        "unknown issuer",
+        "unknownissuer",
+        "certificate has expired",
+    ]
+    .iter()
+    .any(|phrase| text.contains(phrase))
+    {
+        "tls_certificate_validation"
+    } else if [
+        "dns error",
+        "failed to lookup address",
+        "name or service not known",
+        "temporary failure in name resolution",
+    ]
+    .iter()
+    .any(|phrase| text.contains(phrase))
+    {
+        "dns_resolution"
+    } else if text.contains("connection reset") {
+        "connection_reset"
+    } else if [
+        "connection closed",
+        "connection was closed",
+        "connection is closed",
+        "connection closed before message completed",
+        "unexpected eof",
+    ]
+    .iter()
+    .any(|phrase| text.contains(phrase))
+    {
+        "connection_closed"
+    } else if text.contains("broken pipe") {
+        "broken_pipe"
+    } else if text.contains("timed out") {
+        "timeout"
+    } else {
+        "redacted"
+    }
+}
+
+/// Only emit typed, allowlisted diagnostics. Display/Debug on a transport source
+/// can contain signed URLs, headers, credentials, or response bodies, so even
+/// "sanitized" free-form source text is deliberately excluded.
+fn safe_source_chain(error: &(dyn std::error::Error + 'static)) -> String {
+    use std::fmt::Write;
+    const MAX_DEPTH: usize = 12;
+    let mut details = String::new();
+    let mut source = error.source();
+    for depth in 0..MAX_DEPTH {
+        let Some(error) = source else { return details };
+        if let Some(io) = error.downcast_ref::<std::io::Error>() {
+            // ErrorKind's Debug is a standard-library enum, not source text.
+            let _ = write!(details, "; cause[{depth}]=io::{:?}", io.kind());
+            if let Some(code) = io.raw_os_error() {
+                let _ = write!(details, "(os_code={code})");
+            }
+            let label = safe_transport_label(error);
+            if label != "redacted" {
+                let _ = write!(details, "({label})");
+            }
+        } else {
+            let _ = write!(details, "; cause[{depth}]={}", safe_transport_label(error));
+        }
+        source = error.source();
+    }
+    if source.is_some() {
+        details.push_str("; causes_truncated");
+    }
+    details
+}
+
+fn safe_sdk_details<E>(err: &aws_sdk_s3::error::SdkError<E>) -> String
+where
+    E: aws_sdk_s3::error::ProvideErrorMetadata + std::error::Error + Send + Sync + 'static,
+{
+    use aws_sdk_s3::error::SdkError;
+    use std::fmt::Write;
+    let kind = match err {
+        SdkError::DispatchFailure(failure) if failure.is_timeout() => "dispatch_timeout",
+        SdkError::DispatchFailure(failure) if failure.is_io() => "dispatch_io",
+        SdkError::DispatchFailure(failure) if failure.is_user() => "dispatch_user",
+        SdkError::DispatchFailure(_) => "dispatch_other",
+        SdkError::TimeoutError(_) => "timeout",
+        SdkError::ConstructionFailure(_) => "construction",
+        SdkError::ResponseError(_) => "response",
+        SdkError::ServiceError(_) => "service",
+        _ => "unknown",
+    };
+    let mut details = kind.to_owned();
+    if let Some(response) = err.raw_response() {
+        let _ = write!(details, "; http_status={}", response.status().as_u16());
+    }
+    if let Some(code) = err_code(err) {
+        // Metadata comes from the remote server, not a trusted enum.
+        let code = match code {
+            "SlowDown"
+            | "RequestLimitExceeded"
+            | "ThrottlingException"
+            | "TooManyRequests"
+            | "InternalError"
+            | "ServiceUnavailable"
+            | "RequestTimeout"
+            | "AccessDenied"
+            | "NoSuchBucket"
+            | "NoSuchKey"
+            | "PreconditionFailed"
+            | "ConditionalRequestConflict"
+            | "InvalidAccessKeyId"
+            | "EntityTooLarge" => code,
+            _ => "unrecognized",
+        };
+        let _ = write!(details, "; service_code={code}");
+    }
+    details.push_str(&safe_source_chain(err));
+    details
+}
