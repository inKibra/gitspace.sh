+/// Large concurrent creates must never overwrite the winner, including at multipart completion.
+async fn test_multipart_create_wins_once(store: &DynStore, key: &str) {
+    let first = Bytes::from(vec![0x31; 6 * 1024 * 1024]);
+    let second = Bytes::from(vec![0x72; 6 * 1024 * 1024]);
+    let options = PutOptions {
+        mode: PutMode::Create,
+        ..Default::default()
+    };
+    let (left, right) = futures::future::join(
+        store.put(key, PutBody::Bytes(first.clone()), options.clone()),
+        store.put(key, PutBody::Bytes(second.clone()), options),
+    )
+    .await;
+    let expected = match (left, right) {
+        (Ok(_), Err(StoreError::PreconditionFailed { .. })) => first.clone(),
+        (Err(StoreError::PreconditionFailed { .. }), Ok(_)) => second,
+        results => panic!("exactly one large create must win: {results:?}"),
+    };
+
+    let stale_update = store
+        .put(
+            key,
+            PutBody::Bytes(first),
+            PutOptions {
+                mode: PutMode::Update(walgit_store::Version::new("stale")),
+                ..Default::default()
+            },
+        )
+        .await;
+    assert!(matches!(
+        stale_update,
+        Err(StoreError::PreconditionFailed { .. })
+    ));
+    let (_, actual) = collect_body(
+        store
+            .get(key, GetOptions::default())
+            .await
+            .expect("read the winning large create"),
+    )
+    .await;
+    assert_eq!(actual, expected, "the winner must remain byte-exact");
+    store.delete(key, None).await.expect("cleanup large create");
+}
