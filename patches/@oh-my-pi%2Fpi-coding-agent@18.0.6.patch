 	return availableModels[0];
 }
+
+/**
+ * GITSPACE PATCH — agents address models by ROLE, never by model id.
+ *
+ * Throws when `value` names a concrete model (`openai-codex/gpt-5.5`) rather
+ * than a role (`pi/smol`, optionally with a `:thinking` suffix). Roles are the
+ * single place an operator binds capability→model; a hardcoded model id in an
+ * agent-authored spawn silently opts out of that config, rots when model ids
+ * change (gpt-5.5 → gpt-5.6-luna), and makes spend unattributable to a role.
+ *
+ * Deliberately NOT wired into `resolveAgentModelPatterns` itself: that resolver
+ * also serves human surfaces (the agent dashboard) and agent-definition
+ * frontmatter, where naming a concrete model is legitimate. This guard is for
+ * the agent-facing spawn path only.
+ *
+ * `undefined` is allowed — it means "inherit", which is the desired default.
+ */
+export function assertRoleOnlyModelSelector(value: string | string[] | undefined, settings?: Settings): void {
+	const patterns = normalizeModelPatternList(value);
+	if (patterns.length === 0) return;
+
+	// Every role the operator can see under settings > Models > model roles:
+	// non-hidden built-ins PLUS custom roles introduced via cycleOrder,
+	// modelRoles or modelTags. Deliberately NOT limited to roles that already
+	// have a model bound, nor to the quick-cycle subset — an agent may name any
+	// role the operator has, bound or not.
+	const knownRoles = settings ? getKnownRoleIds(settings) : (MODEL_ROLE_IDS as string[]);
+	const known = new Set(knownRoles);
+
+	const offenders = patterns.filter(pattern => {
+		const trimmed = pattern.trim();
+		const prefix = [MODEL_ROLE_ALIAS_PREFIX, LEGACY_MODEL_ROLE_ALIAS_PREFIX].find(candidate => trimmed.startsWith(candidate));
+		if (!prefix) return true;
+		const { base } = splitThinkingSuffix(trimmed, prefix.length, MAX_THINKING_SUFFIX_OPTIONS);
+		return !known.has(base.slice(prefix.length));
+	});
+	if (offenders.length === 0) return;
+
+	throw new Error(
+		`model must name a role, not a model id. Got ${offenders.map(o => JSON.stringify(o)).join(", ")}. ` +
+			`Available roles: ${knownRoles.map(role => `pi/${role}`).join(", ")}. ` +
+			`Roles are bound to models in settings, so this stays correct when models change. ` +
+			`Omit \`model\` to inherit the session's model, or use \`agent=<name>\` to pick a named subagent.`,
+	);
+}
