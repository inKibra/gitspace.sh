+	/** Remove a queued user message by visible kind + index (GitSpace patch).
+	 *  Maps the display index (user-visible messages, matching getQueuedMessages)
+	 *  to the raw queue index and removes it via the agent. */
+	removeQueuedMessage(kind: "steering" | "followUp", index: number): string | undefined {
+		const queue = kind === "steering" ? this.agent.peekSteeringQueue() : this.agent.peekFollowUpQueue();
+		const userIndices: number[] = [];
+		queue.forEach((m, i) => {
+			if (isUserQueuedMessage(m)) userIndices.push(i);
+		});
+		const rawIndex = userIndices[index];
+		if (rawIndex === undefined) return undefined;
+		const removed = queue[rawIndex];
+		if (kind === "steering") this.agent.removeSteer(rawIndex);
+		else this.agent.removeFollowUp(rawIndex);
+		return removed ? queueChipText(removed) : undefined;
+	}
+
