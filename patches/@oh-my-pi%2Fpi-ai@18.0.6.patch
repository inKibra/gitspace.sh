+export async function refreshOpenAICodexTokenPortable(
+	refreshToken: string,
+	fetchOverride?: FetchImpl,
+): Promise<OpenAICodexRefreshTokenResponse> {
+	const data = await requestWorkerOAuthToken({
+		provider: "openai-codex",
+		url: "https://auth.openai.com/oauth/token",
+		headers: { "content-type": "application/x-www-form-urlencoded" },
+		body: new URLSearchParams({
+			grant_type: "refresh_token",
+			refresh_token: refreshToken,
+			client_id: "app_EMoamEEZ73f0CkXaXp7hrann",
+		}),
+		fetchOverride,
+	});
+	if (typeof data.access_token !== "string" || typeof data.refresh_token !== "string" || typeof data.expires_in !== "number" || !Number.isFinite(data.expires_in) || data.expires_in <= 0) {
+		throw new WorkerOAuthRefreshError("openai-codex", "invalid-response", 200, "missing token fields");
+	}
+	return { access_token: data.access_token, refresh_token: data.refresh_token, expires_in: data.expires_in };
