{
  "version": 1,
  "defaultProfile": "base",
  "profiles": {
    "base": {
      "checks": [
        "bun",
        "gh"
      ],
      "secrets": [
        "EXAMPLE_API_TOKEN"
      ],
      "values": [
        "DEVELOPER_NAME"
      ],
      "notes": "Development setup for GitSpace. Bun and an authenticated GitHub CLI are required."
    }
  },
  "checks": {
    "bun": {
      "kind": "built-in",
      "check": "bun",
      "label": "Bun runtime"
    },
    "gh": {
      "kind": "built-in",
      "check": "gh",
      "label": "GitHub CLI"
    }
  },
  "values": {
    "DEVELOPER_NAME": {
      "default": "Developer",
      "description": "Name used by development scripts."
    }
  }
}
