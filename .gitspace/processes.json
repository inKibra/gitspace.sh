{
  "processes": [
    {
      "name": "sample-events",
      "command": "bun",
      "args": ["scripts/sample-events.ts"],
      "autostart": false,
      "events": {
        "keepRawOutput": false,
        "correlationField": "requestId",
        "aggregateMode": "stream",
        "updateIntervalMs": 200,
        "maxTimeline": 50
      },
      "restart": {
        "policy": "always",
        "maxAttempts": 10,
        "backoffMs": 2000,
        "maxBackoffMs": 15000
      }
    },
    {
      "name": "sample-server",
      "command": "bun",
      "args": ["sample-server/index.ts"],
      "autostart": false,
      "ports": [
        { "port": 7777, "name": "web", "protocol": "http" }
      ],
      "restart": {
        "policy": "on-failure",
        "maxAttempts": 5,
        "backoffMs": 2000,
        "maxBackoffMs": 10000
      }
    }
  ]
}
