{
  "$schema": "https://holocron.so/docs.json",
  "name": "GitSpace",
  "description": "Run coding agents across your own machines and workspaces.",
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg",
    "href": "https://gitspace.sh/"
  },
  "favicon": {
    "light": "/favicon.png",
    "dark": "/favicon.png"
  },
  "colors": {
    "primary": "#171717"
  },
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "assistant": {
    "enabled": false
  },
  "navbar": {
    "links": [
      { "label": "GitSpace", "href": "/" },
      { "type": "github", "href": "https://github.com/inKibra/gitspace.sh" }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/getting-started"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/inKibra/gitspace.sh",
          "icon": "github",
          "placement": "sidebar"
        }
      ]
    },
    "groups": [
      {
        "group": "Start",
        "icon": "play",
        "pages": ["index", "getting-started"]
      },
      {
        "group": "Use GitSpace",
        "icon": "panels-top-left",
        "pages": ["concepts", "agent-workflow", "workspace-lifecycle", "remote-access"]
      },
      {
        "group": "Reference",
        "icon": "terminal",
        "pages": ["cli-reference", "lifecycle-reference", "security/remote-access"]
      }
    ]
  }
}
