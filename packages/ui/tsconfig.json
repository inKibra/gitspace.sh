{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "paths": { "@/*": ["./src/fluid-vendor/*"] },
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "panda.config.ts", "panda.preset.ts"]
}
