{
  "name": "@gitspace/deployment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./distribution": "./src/distribution.ts",
    "./manifest": "./src/executable-manifest.ts",
    "./machine-assembly": "./src/machine-assembly.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.test.json",
    "test": "bun ../../scripts/test-isolated.ts test",
    "release:build": "bun src/release.ts build",
    "release:publish": "bun src/release.ts publish",
    "release:default": "bun src/default-release-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1132.0",
    "@gitspace/browser-runner": "workspace:*",
    "@gitspace/inference-worker": "workspace:*",
    "@gitspace/protocol": "workspace:*",
    "@jridgewell/remapping": "2.3.5",
    "@noble/curves": "^2.2.0",
    "better-result": "3.0.1",
    "zod": "^4.4.3"
  }
}
