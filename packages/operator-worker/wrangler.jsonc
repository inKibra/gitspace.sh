{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitspace-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "PLATFORM_URL": "https://platform.gssh.dev",
    "ACCESS_TEAM_DOMAIN": "https://inkibra.cloudflareaccess.com",
    "ACCESS_AUD": "b2e78441a0b1f9493647248fd9ae282982fdaff69fb118ff21a1ed1095679ec0",
    "OPERATOR_EMAIL": "bradleat@inkibra.com"
  },
  "assets": {
    "directory": "../operator-web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "DISTRIBUTION",
      "bucket_name": "gitspace-data"
    }
  ],
  "services": [],
  "routes": [
    {
      "pattern": "gitspace.sh/*",
      "zone_name": "gitspace.sh"
    },
    {
      "pattern": "api.gitspace.sh/*",
      "zone_name": "gitspace.sh"
    },
    {
      "pattern": "api.gitspace.sh",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INVITES",
        "class_name": "InviteRegistryDO"
      },
      {
        "name": "ACCOUNTS",
        "class_name": "AccountRegistryDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "operator-v1",
      "new_sqlite_classes": [
        "InviteRegistryDO",
        "AccountRegistryDO"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
