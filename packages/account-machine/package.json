{
  "name": "@gitspace/account-machine",
  "version": "0.0.0",
  "private": true,
  "gitspace": {
    "inferenceVersion": 1
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun src/runtime.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.test.json",
    "test": "bun ../../scripts/test-isolated.ts test",
    "test:browser-relay:integration": "bun scripts/browser-relay-integration.ts"
  },
  "dependencies": {
    "@gitspace/browser-extension": "workspace:*",
    "@gitspace/deployment": "workspace:*",
    "@gitspace/protocol": "workspace:*",
    "@gitspace/protocol-environment": "workspace:*",
    "@gitspace/protocol-runtime": "workspace:*",
    "@gitspace/protocol-sync": "workspace:*",
    "@gitspace/protocol-workspace": "workspace:*",
    "@gitspace/runtime-machine": "workspace:*",
    "@gitspace/supervisor": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "aws4fetch": "1.0.20",
    "devalue": "5.8.2",
    "result-rpc": "0.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "fflate": "0.8.3"
  }
}
