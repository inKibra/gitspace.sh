new file mode 100644
index 0000000000000000000000000000000000000000..9556fb9baa78aa9bfca94455a10f4fb1a7400bc4
--- /dev/null
+++ b/src/session/model-usage.ts
@@ -0,0 +1,40 @@
+import type { Usage } from "@oh-my-pi/pi-ai";
+import { EPHEMERAL_MODEL_CHANGE_ROLE } from "./session-entries";
+import type { SessionManager } from "./session-manager";
+
+export interface HistoricalModelSelection {
+	role: string | null;
+	selection: "role" | "pinned" | "inherited" | "unknown";
+}
+
+export interface DirectModelUsage extends HistoricalModelSelection {
+	version: 1;
+	id: string;
+	kind: "completion";
+	provider: string;
+	model: string;
+	usage: Usage;
+}
+
+/** Follow the active branch without inferring semantic roles from model identity. */
+export function getHistoricalModelSelection(manager: SessionManager): HistoricalModelSelection {
+	let entry = manager.getLeafEntry();
+	while (entry) {
+		if (entry.type === "custom" && (entry.customType === "gitspace-model-selection" || entry.customType === "gitspace-agent-definition")) {
+			const data = entry.data as Partial<HistoricalModelSelection> | undefined;
+			if (data && (data.role === null || typeof data.role === "string") &&
+				(data.selection === "role" || data.selection === "pinned" || data.selection === "inherited" || data.selection === "unknown")) {
+				return { role: data.role, selection: data.selection };
+			}
+		}
+		if (entry.type === "session_init" && entry.modelRole) {
+			return { role: entry.modelRole, selection: "role" };
+		}
+		if (entry.type === "model_change" && entry.role !== EPHEMERAL_MODEL_CHANGE_ROLE) {
+			if (entry.role === "temporary") return { role: null, selection: "pinned" };
+			return entry.role ? { role: entry.role, selection: "role" } : { role: null, selection: "unknown" };
+		}
+		entry = entry.parentId ? manager.getEntry(entry.parentId) : undefined;
+	}
+	return { role: null, selection: "unknown" };
+}
