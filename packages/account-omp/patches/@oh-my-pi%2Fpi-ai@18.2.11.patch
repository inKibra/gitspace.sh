+++ b/src/managed-inference.ts
@@ -0,0 +1,52 @@
+import type { AuthStorage } from "./auth-storage";
+import type { Api, Model, SimpleStreamOptions, StreamOptions } from "./types";
+import { AssistantMessageEventStream } from "./utils/event-stream";
+
+/** A host-owned, process-lifetime admission. No credential bytes are stored globally. */
+export interface ManagedInferenceGuard {
+	readonly authStorage: AuthStorage;
+	prepare(model: Model<Api>, options: SimpleStreamOptions): Promise<SimpleStreamOptions>;
+}
+let guard: ManagedInferenceGuard | undefined;
+
+/** Install before SDK initialization. A child cannot be rebound to another admission. */
+export function installManagedInferenceGuard(value: ManagedInferenceGuard): void {
+	if (guard) throw new Error("Managed inference is already bound; reopen the child for a new admission");
+	guard = value;
+}
+
+export function hasManagedInferenceGuard(): boolean { return guard !== undefined || process.env.GITSPACE_MANAGED_INFERENCE === "1"; }
+export function managedInferenceAuthStorage(): AuthStorage | undefined {
+	if (!guard && hasManagedInferenceGuard()) throw new Error("Managed inference requires an initialized profile scope in this process");
+	return guard?.authStorage;
+}
+export async function prepareManagedInference<T extends StreamOptions | SimpleStreamOptions>(model: Model<Api>, options: T): Promise<T> {
+	managedInferenceAuthStorage();
+	return guard ? await guard.prepare(model, options as SimpleStreamOptions) as T : options;
+}
+export function assertManagedInferenceEndpoint(model: Model<Api>, endpoint: string): void {
+	if (!guard) return;
+	if (new URL(endpoint).origin !== new URL(model.baseUrl).origin) {
+		throw new Error("Managed compaction endpoint must belong to the admitted provider");
+	}
+}
+
+/** Both simple and API-specific dispatch, including every auth-retry attempt, enter here. */
+export function guardManagedInference<T extends StreamOptions | SimpleStreamOptions>(
+	model: Model<Api>, options: T | undefined,
+	dispatch: (options: T) => AssistantMessageEventStream,
+): AssistantMessageEventStream {
+	managedInferenceAuthStorage();
+	if (!guard) return dispatch((options ?? {}) as T);
+	const outer = new AssistantMessageEventStream();
+	void (async () => {
+		try {
+			const prepared = await guard!.prepare(model, (options ?? {}) as SimpleStreamOptions);
+			if (prepared.signal?.aborted) throw prepared.signal.reason ?? new Error("Inference aborted");
+			const inner = dispatch(prepared as T);
+			for await (const event of inner) outer.push(event);
+			if (!outer.done) outer.end(await inner.result());
+		} catch (error) { outer.fail(error); }
+	})();
+	return outer;
+}
