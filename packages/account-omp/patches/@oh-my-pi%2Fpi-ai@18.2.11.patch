+import type { FetchImpl } from "../../types";
+import { WorkerOAuthRefreshError, requestWorkerOAuthToken } from "./worker-refresh";
+
+const CLIENT_ID = atob("OWQxYzI1MGEtZTYxYi00NGQ5LTg4ZWQtNTk0NGQxOTYyZjVl");
+
+export interface AnthropicRefreshTokenResponse {
+	access_token: string;
+	refresh_token: string;
+	expires_in: number;
+	account?: { uuid?: string; email_address?: string };
+	organization?: { uuid?: string; name?: string };
+}
+
+export async function refreshAnthropicTokenPortable(
+	refreshToken: string,
+	fetchOverride?: FetchImpl,
+): Promise<AnthropicRefreshTokenResponse> {
+	const data = await requestWorkerOAuthToken({
+		provider: "anthropic",
+		url: "https://api.anthropic.com/v1/oauth/token",
+		headers: {
+			"content-type": "application/json",
+			"anthropic-beta": "oauth-2025-04-20",
+			"user-agent": "anthropic-sdk-typescript/0.94.0 userOAuthProvider",
+		},
+		body: JSON.stringify({ grant_type: "refresh_token", client_id: CLIENT_ID, refresh_token: refreshToken }),
+		fetchOverride,
+	});
+	if (typeof data.access_token !== "string" || typeof data.expires_in !== "number" || !Number.isFinite(data.expires_in) || data.expires_in <= 0) {
+		throw new WorkerOAuthRefreshError("anthropic", "invalid-response", 200, "missing token fields");
+	}
+	if (data.refresh_token !== undefined && typeof data.refresh_token !== "string") {
+		throw new WorkerOAuthRefreshError("anthropic", "invalid-response", 200, "invalid refresh token");
+	}
+	return {
+		access_token: data.access_token,
+		refresh_token: data.refresh_token || refreshToken,
+		expires_in: data.expires_in,
+		...(data.account && typeof data.account === "object" ? { account: data.account as AnthropicRefreshTokenResponse["account"] } : {}),
+		...(data.organization && typeof data.organization === "object" ? { organization: data.organization as AnthropicRefreshTokenResponse["organization"] } : {}),
+	};
+}
