+import type { FetchImpl } from "../../types";
+import type { OAuthCredentials } from "./types";
+import { WorkerOAuthRefreshError, googleOAuthClient, requestWorkerOAuthToken } from "./worker-refresh";
+
+export async function refreshAntigravityTokenPortable(
+	refreshToken: string,
+	projectId: string,
+	fetchOverride?: FetchImpl,
+): Promise<OAuthCredentials> {
+	const { clientId, clientSecret } = googleOAuthClient("google-antigravity");
+	const data = await requestWorkerOAuthToken({
+		provider: "google-antigravity",
+		url: "https://oauth2.googleapis.com/token",
+		headers: { "content-type": "application/x-www-form-urlencoded" },
+		body: new URLSearchParams({ client_id: clientId, client_secret: clientSecret, refresh_token: refreshToken, grant_type: "refresh_token" }),
+		fetchOverride,
+	});
+	if (typeof data.access_token !== "string" || typeof data.expires_in !== "number" || !Number.isFinite(data.expires_in) || data.expires_in <= 0) {
+		throw new WorkerOAuthRefreshError("google-antigravity", "invalid-response", 200, "missing token fields");
+	}
+	if (data.refresh_token !== undefined && typeof data.refresh_token !== "string") {
+		throw new WorkerOAuthRefreshError("google-antigravity", "invalid-response", 200, "invalid refresh token");
+	}
+	return {
+		refresh: data.refresh_token || refreshToken,
+		access: data.access_token,
+		expires: Date.now() + data.expires_in * 1000 - 5 * 60 * 1000,
+		projectId,
+	};
+}
