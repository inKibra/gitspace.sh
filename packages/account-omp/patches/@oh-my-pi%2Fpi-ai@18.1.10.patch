diff --git a/src/registry/oauth/worker-refresh.ts b/src/registry/oauth/worker-refresh.ts
new file mode 100644
--- /dev/null
+++ b/src/registry/oauth/worker-refresh.ts
@@ -0,0 +1,87 @@
+import { authPolicyFor } from "@oh-my-pi/pi-catalog/compat/auth";
+import type { FetchImpl } from "../../types";
+
+const MAX_RESPONSE_BYTES = 64 * 1024;
+
+/** Read public Google OAuth client metadata from the same catalog as the native auth engine. */
+export function googleOAuthClient(provider: "google-gemini-cli" | "google-antigravity"): { clientId: string; clientSecret: string } {
+	const login = authPolicyFor(provider)?.login;
+	if (login?.kind !== "oauth-code" || !login.clientId?.value || !login.clientSecret?.value) {
+		throw new Error(`Missing OAuth client metadata for ${provider}`);
+	}
+	return {
+		clientId: login.clientId.encoding === "base64" ? atob(login.clientId.value) : login.clientId.value,
+		clientSecret: login.clientSecret.encoding === "base64" ? atob(login.clientSecret.value) : login.clientSecret.value,
+	};
+}
+
+export class WorkerOAuthRefreshError extends Error {
+	constructor(
+		readonly provider: string,
+		readonly kind: "network" | "rejected" | "invalid-response",
+		readonly status: number | undefined,
+		readonly responseBody: string,
+	) {
+		super(`${provider} OAuth refresh ${kind}`);
+		this.name = "WorkerOAuthRefreshError";
+	}
+}
+
+async function boundedText(response: Response): Promise<string> {
+	const declared = Number(response.headers.get("content-length"));
+	if (Number.isFinite(declared) && declared > MAX_RESPONSE_BYTES) throw new Error("response too large");
+	if (!response.body) return "";
+	const reader = response.body.getReader();
+	const decoder = new TextDecoder();
+	let size = 0;
+	let text = "";
+	try {
+		while (true) {
+			const chunk = await reader.read();
+			if (chunk.done) return text + decoder.decode();
+			size += chunk.value.byteLength;
+			if (size > MAX_RESPONSE_BYTES) {
+				await reader.cancel();
+				throw new Error("response too large");
+			}
+			text += decoder.decode(chunk.value, { stream: true });
+		}
+	} finally {
+		reader.releaseLock();
+	}
+}
+
+export async function requestWorkerOAuthToken(input: {
+	provider: string;
+	url: string;
+	headers: HeadersInit;
+	body: BodyInit;
+	fetchOverride?: FetchImpl;
+	timeoutMs?: number;
+}): Promise<Record<string, unknown>> {
+	let response: Response;
+	try {
+		response = await (input.fetchOverride ?? fetch)(input.url, {
+			method: "POST",
+			headers: input.headers,
+			body: input.body,
+			signal: AbortSignal.timeout(input.timeoutMs ?? 15_000),
+		});
+	} catch {
+		throw new WorkerOAuthRefreshError(input.provider, "network", undefined, "");
+	}
+	let text: string;
+	try {
+		text = await boundedText(response);
+	} catch {
+		throw new WorkerOAuthRefreshError(input.provider, "invalid-response", response.status, "response too large");
+	}
+	if (!response.ok) throw new WorkerOAuthRefreshError(input.provider, "rejected", response.status, text);
+	try {
+		const parsed = JSON.parse(text) as unknown;
+		if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) throw new Error("not an object");
+		return parsed as Record<string, unknown>;
+	} catch {
+		throw new WorkerOAuthRefreshError(input.provider, "invalid-response", response.status, text);
+	}
+}
