{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitspace-relay-platform-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CREDITS",
        "class_name": "CreditLedgerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CreditLedgerDO"]
    }
  ],
  "dispatch_namespaces": [
    {
      "binding": "DISPATCHER",
      "namespace": "gitspace-relays-spike"
    }
  ],
  "routes": [
    {
      "pattern": "alpha-relay-spike.gssh.dev",
      "custom_domain": true
    },
    {
      "pattern": "beta-relay-spike.gssh.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "TENANT_HOST_SUFFIX": "-relay-spike.gssh.dev",
    "DEFAULT_CPU_MS": 50,
    "DEFAULT_SUBREQUESTS": 20,
    "ADMIN_PUBLIC_KEY": "vOSduG2Ge02PoTK0oGKKFODyStGjBO46mv9TQXdRmLA=",
    "ADMIN_AUTH_MAX_SKEW_MS": 60000,
    "DISPATCH_RESERVATION_MICROS": 100,
    "DISPATCH_SETTLEMENT_MICROS": 1,
    "RESERVATION_TTL_MS": 30000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
