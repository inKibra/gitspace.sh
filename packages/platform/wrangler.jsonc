{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitspace-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CREDITS",
        "class_name": "CreditLedgerDO"
      },
      {
        "name": "DEPLOYMENTS",
        "class_name": "TenantDeploymentsDO"
      },
      {
        "name": "TENANT_CONTROL",
        "class_name": "TenantControlDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CreditLedgerDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TenantDeploymentsDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["TenantControlDO"]
    }
  ],
  "dispatch_namespaces": [
    {
      "binding": "DISPATCHER",
      "namespace": "gitspace-relays"
    }
  ],
  // RELEASES keeps a copy of every tenant worker bundle the platform uploaded
  // (`tenants/<tenant>/<sha>/worker.mjs`) plus our channel build at
  // `channel/worker.mjs` + `channel/metadata.json` (WorkerReleaseMetadata).
  // DATA is the tenant data bucket; tenants stage `releases/<sha>/worker.mjs`
  // there and hand the platform the full object key.
  "r2_buckets": [
    { "binding": "RELEASES", "bucket_name": "gitspace-platform-releases" },
    { "binding": "DATA", "bucket_name": "gitspace-data" }
  ],
  "services": [
    { "binding": "AUTH", "service": "gitspace-auth" }
  ],
  "routes": [
    {
      "pattern": "platform.gssh.dev",
      "custom_domain": true
    },
    {
      "pattern": "*.gssh.dev/*",
      "zone_name": "gssh.dev"
    }
  ],
  // Secrets: CF_API_TOKEN uploads tenant relay scripts; PLATFORM_BOOTSTRAP_TOKEN
  // authenticates bootstrap, account lifecycle, and account-bound deployment calls from gitspace-auth.
  "vars": {
    "TENANT_HOST_SUFFIX": ".gssh.dev",
    "OPERATOR_URL": "https://api.gitspace.sh",
    "DEFAULT_CPU_MS": 50,
    "DEFAULT_SUBREQUESTS": 20,
    "ADMIN_PUBLIC_KEY": "vOSduG2Ge02PoTK0oGKKFODyStGjBO46mv9TQXdRmLA=",
    "ADMIN_AUTH_MAX_SKEW_MS": 60000,
    "DISPATCH_RESERVATION_MICROS": 100,
    "DISPATCH_SETTLEMENT_MICROS": 1,
    "DEPLOY_SETTLEMENT_MICROS": 1000,
    "DEPLOY_PROBE_DELAY_MS": 2000,
    "RESERVATION_TTL_MS": 30000,
    "DISPATCH_NAMESPACE": "gitspace-relays",
    "CF_ACCOUNT_ID": "2ed07d2f77ecb2aa43ca99a9c970597c"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
