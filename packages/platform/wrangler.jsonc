{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitspace-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CREDITS",
        "class_name": "CreditLedgerDO"
      },
      {
        "name": "DEPLOYMENTS",
        "class_name": "TenantDeploymentsDO"
      },
      {
        "name": "TENANT_CONTROL",
        "class_name": "TenantControlDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CreditLedgerDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "TenantDeploymentsDO"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "TenantControlDO"
      ]
    }
  ],
  "dispatch_namespaces": [
    {
      "binding": "DISPATCHER",
      "namespace": "gitspace-relays"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "gitspace-platform-releases"
    }
  ],
  "services": [
    {
      "binding": "COMPUTE",
      "service": "gitspace-sandbox-worker"
    }
  ],
  "routes": [
    {
      "pattern": "platform.gssh.dev",
      "custom_domain": true
    },
    {
      "pattern": "*.gssh.dev/*",
      "zone_name": "gssh.dev"
    },
    {
      "pattern": "*.gitspace.sh/*",
      "zone_name": "gitspace.sh"
    }
  ],
  "vars": {
    "TENANT_HOST_SUFFIX": ".gssh.dev",
    "DEFAULT_CPU_MS": 50,
    "DEFAULT_SUBREQUESTS": 20,
    "ADMIN_PUBLIC_KEY": "vOSduG2Ge02PoTK0oGKKFODyStGjBO46mv9TQXdRmLA=",
    "ADMIN_AUTH_MAX_SKEW_MS": 60000,
    "DISPATCH_SETTLEMENT_MICROS": 1,
    "DEPLOY_SETTLEMENT_MICROS": 1000,
    "DEPLOY_PROBE_DELAY_MS": 2000,
    "DISPATCH_NAMESPACE": "gitspace-relays",
    "CF_ACCOUNT_ID": "2ed07d2f77ecb2aa43ca99a9c970597c",
    "PLATFORM_URL": "https://platform.gssh.dev",
    "PLATFORM_SERVICE_NAME": "gitspace-platform",
    "PUBLIC_ASSETS_SERVICE": "gitspace-auth"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
