{
  "name": "@gitspace/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "types": "wrangler types worker-configuration.d.ts --include-runtime false --config wrangler.jsonc",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "deploy:dry": "wrangler deploy --dry-run --config wrangler.jsonc",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@gitspace/protocol": "workspace:*",
    "better-result": "3.0.1"
  }
}
