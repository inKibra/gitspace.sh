{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitspace-credit-platform-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "CREDITS", "class_name": "CreditLedgerDO" },
      { "name": "DEPLOYMENTS", "class_name": "TenantDeploymentsDO" },
      { "name": "TENANT_CONTROL", "class_name": "TenantControlDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CreditLedgerDO"] },
    { "tag": "v2", "new_sqlite_classes": ["TenantDeploymentsDO"] },
    { "tag": "v3", "new_sqlite_classes": ["TenantControlDO"] }
  ],
  "r2_buckets": [
    { "binding": "RELEASES", "bucket_name": "gitspace-platform-releases-test" },
    { "binding": "DATA", "bucket_name": "gitspace-data-test" }
  ],
  "vars": {
    "TENANT_HOST_SUFFIX": "-test.invalid",
    "OPERATOR_URL": "https://authority.test",
    "DEFAULT_CPU_MS": 50,
    "DEFAULT_SUBREQUESTS": 20,
    "ADMIN_PUBLIC_KEY": "test",
    "ADMIN_AUTH_MAX_SKEW_MS": 60000,
    "DISPATCH_RESERVATION_MICROS": 100,
    "DISPATCH_SETTLEMENT_MICROS": 1,
    "DEPLOY_SETTLEMENT_MICROS": 1000,
    "DEPLOY_PROBE_DELAY_MS": 5,
    "RESERVATION_TTL_MS": 30000,
    "DISPATCH_NAMESPACE": "gitspace-relays-test",
    "CF_ACCOUNT_ID": "test-account",
    "CF_API_TOKEN": "test-api-token",
    "PLATFORM_BOOTSTRAP_TOKEN": "test-bootstrap-token"
  }
}
