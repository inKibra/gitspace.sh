{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitspace-relay-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "UserRelayDO"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "gitspace-relay-spike-standalone"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayDO"]
    },
    {
      "tag": "v2",
      "renamed_classes": [
        {
          "from": "RelayDO",
          "to": "UserRelayDO"
        }
      ]
    }
  ],
  "vars": {
    "AUTH_PUBLIC_KEY": "replace-with-base64-ed25519-public-key",
    "RELAY_NAME": "default",
    "AUTH_MAX_SKEW_MS": 60000,
    "TUNNEL_HEADER_TIMEOUT_MS": 10000,
    "TUNNEL_IDLE_TIMEOUT_MS": 30000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
