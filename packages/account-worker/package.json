{
  "name": "@gitspace/account-worker",
  "version": "0.0.0",
  "private": true,
  "gitspace": {
    "inferenceVersion": 1
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "types": "wrangler types worker-configuration.d.ts --include-runtime false --config wrangler.jsonc",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p test/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "deploy:dry": "wrangler deploy --dry-run --config wrangler.jsonc"
  },
  "dependencies": {
    "@ast-grep/wasm": "0.51.0",
    "@composio/core": "0.18.0",
    "@earendil-works/chord": "1.3.0",
    "@gitspace/account-machine": "workspace:*",
    "@gitspace/blocks": "workspace:*",
    "@gitspace/catalog": "workspace:*",
    "@gitspace/mcp-server": "workspace:*",
    "@gitspace/protocol": "workspace:*",
    "@gitspace/protocol-agent": "workspace:*",
    "@gitspace/protocol-environment": "workspace:*",
    "@gitspace/protocol-runtime": "workspace:*",
    "@gitspace/protocol-sync": "workspace:*",
    "@gitspace/protocol-workspace": "workspace:*",
    "@gitspace/provider-auth": "workspace:*",
    "@gitspace/runtime-core": "workspace:*",
    "@gitspace/runtime-machine": "workspace:*",
    "@gitspace/runtime-workspace-do": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@noble/curves": "^2.2.0",
    "better-result": "3.0.1",
    "devalue": "5.8.2",
    "fflate": "0.8.3",
    "result-rpc": "0.5.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.26.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@msw/cloudflare": "^0.0.1",
    "msw": "^2.14.0"
  }
}
