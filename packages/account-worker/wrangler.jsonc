{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitspace-account",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal",
    "request_signal_passthrough"
  ],
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "gitspace-local" }
  ],
  "worker_loaders": [{ "binding": "CODEMODE_LOADER" }],
  // The browser runner module is generated, not committed (packages/browser-runner).
  "build": { "command": "bun ../browser-runner/src/write.ts src/generated/browser-runner.js && bun ../inference-worker/src/write.ts src/generated/inference-worker.js" },
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "UserRelayDO"
      },
      {
        "name": "CREDENTIALS",
        "class_name": "CredentialVaultDO"
      },
      {
        "name": "USER_STORAGE",
        "class_name": "UserStorageDO"
      },
      {
        "name": "SPACE_AUTHORITY",
        "class_name": "SpaceAuthorityDO"
      },
      {
        "name": "FLEET_CATALOG",
        "class_name": "FleetCatalogDO"
      },
      {
        "name": "USER_SETTINGS",
        "class_name": "UserSettingsDO"
      },
      {
        "name": "PROJECT_SECRETS",
        "class_name": "ProjectSecretsDO"
      },
      {
        "name": "PROJECT_AUTOMATIONS",
        "class_name": "ProjectAutomationsDO"
      },
      {
        "name": "SPACE_CONTEXT",
        "class_name": "SpaceContextDO"
      },
      {
        "name": "USER_SKILLS",
        "class_name": "UserSkillsDO"
      },
      {
        "name": "USER_PROJECTS",
        "class_name": "UserProjectIndexDO"
      },
      {
        "name": "PROJECT_AUTHORITY",
        "class_name": "ProjectAuthorityDO"
      },
      {
        "name": "USER_MCP_CONNECTIONS",
        "class_name": "UserMcpConnectionsDO"
      },
      {
        "name": "TENANT_RELEASES",
        "class_name": "TenantReleasesDO"
      },
      {
        "name": "HOSTED_ROUTES",
        "class_name": "HostedRouteRegistryDO"
      },
      {
        "name": "ACCOUNT_STATE",
        "class_name": "AccountStateDO"
      },
      {
        "name": "GITHUB_APP",
        "class_name": "GitHubAppDO"
      },
      {
        "name": "BROWSER_SESSION",
        "class_name": "BrowserSessionDO"
      },
      {
        "name": "STORAGE_MIGRATION",
        "class_name": "StorageMigrationDO"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "gitspace-local-tenant"
    },
    {
      "binding": "DATA",
      "bucket_name": "gitspace-local-tenant"
    }
  ],
  "migrations": [
    {
      "tag": "account-v1",
      "new_sqlite_classes": [
        "UserRelayDO",
        "CredentialVaultDO",
        "UserStorageDO",
        "SpaceAuthorityDO",
        "FleetCatalogDO",
        "UserSettingsDO",
        "ProjectSecretsDO",
        "ProjectCronsDO",
        "SpaceContextDO",
        "UserSkillsDO",
        "UserProjectIndexDO",
        "ProjectAuthorityDO",
        "UserMcpConnectionsDO",
        "TenantReleasesDO",
        "HostedRouteRegistryDO",
        "AccountStateDO"
      ]
    },
    {
      "tag": "account-v2-saved-transcripts",
      "new_sqlite_classes": ["SavedTranscriptIndexDO"]
    },
    {
      "tag": "account-v3-drop-saved-transcripts",
      "deleted_classes": ["SavedTranscriptIndexDO"]
    },
    {
      "tag": "account-v4-github-app",
      "new_sqlite_classes": ["GitHubAppDO"]
    },
    {
      "tag": "account-v5-browser-session",
      "new_sqlite_classes": ["BrowserSessionDO"]
    },
    {
      "tag": "account-v6-storage-migration",
      "new_sqlite_classes": ["StorageMigrationDO"]
    },
    {
      "tag": "account-v7-automations",
      "new_sqlite_classes": ["ProjectAutomationsDO"],
      "deleted_classes": ["ProjectCronsDO"]
    }
  ],
  "vars": {
    "AUTH_PUBLIC_KEY": "vOSduG2Ge02PoTK0oGKKFODyStGjBO46mv9TQXdRmLA=",
    "ACCOUNT_ID": "u-8d3c47723aa85a4d61cac88f960c69b3",
    "TENANT_ID": "local",
    "RELAY_NAME": "local",
    "ACCOUNT_URL": "http://localhost:8788",
    "RELAY_URL": "http://localhost:8788",
    "PLATFORM_URL": "http://localhost:8787",
    "STORAGE_BUCKET": "gitspace-local-tenant"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "services": [
    {
      "binding": "ASSETS",
      "service": "gitspace-auth"
    },
    {
      // Published releases, read only (`packages/release-channel`).
      "binding": "RELEASE_CHANNEL",
      "service": "gitspace-release-channel"
    }
  ]
}
