{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitspace-auth-worker-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CF_ACCOUNT_ID": "configure-at-deploy",
    "R2_PARENT_ACCESS_KEY_ID": "configure-at-deploy",
    "GITSPACE_OMP_BROKER_TOKEN": "configure-at-deploy",
    // Platform deploy endpoint + tenant slug; PLATFORM_TENANT_TOKEN is a secret (`wrangler secret put`).
    // All three empty/unset: worker launches are recorded as `skipped`.
    "PLATFORM_URL": "",
    "PLATFORM_TENANT": ""
  },
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "gitspace-data" }
  ],
  "services": [
    { "binding": "SANDBOX_PROVISIONER", "service": "gitspace-sandbox-worker" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CREDENTIALS", "class_name": "CredentialVaultDO" },
      { "name": "USER_STORAGE", "class_name": "UserStorageDO" },
      { "name": "SPACE_AUTHORITY", "class_name": "SpaceAuthorityDO" },
      { "name": "FLEET_CATALOG", "class_name": "FleetCatalogDO" },
      { "name": "USER_SETTINGS", "class_name": "UserSettingsDO" },
      { "name": "USER_HANDLES", "class_name": "HandleRegistryDO" },
      { "name": "PROJECT_SECRETS", "class_name": "ProjectSecretsDO" },
      { "name": "PROJECT_CRONS", "class_name": "ProjectCronsDO" },
      { "name": "SPACE_CONTEXT", "class_name": "SpaceContextDO" },
      { "name": "USER_SKILLS", "class_name": "UserSkillsDO" },
      { "name": "USER_PROJECTS", "class_name": "UserProjectIndexDO" },
      { "name": "PROJECT_AUTHORITY", "class_name": "ProjectAuthorityDO" },
      { "name": "USER_MCP_CONNECTIONS", "class_name": "UserMcpConnectionsDO" },
      { "name": "TENANT_RELEASES", "class_name": "TenantReleasesDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CredentialVaultDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UserStorageDO"] },
    { "tag": "v3", "new_sqlite_classes": ["SpaceAuthorityDO"] },
    { "tag": "v4", "new_sqlite_classes": ["FleetCatalogDO"] },
    { "tag": "v5", "new_sqlite_classes": ["UserSettingsDO", "HandleRegistryDO"] },
    { "tag": "v6", "new_sqlite_classes": ["ProjectSecretsDO"] },
    { "tag": "v7", "new_sqlite_classes": ["ProjectCronsDO", "SpaceContextDO"] },
    { "tag": "v8", "new_sqlite_classes": ["UserSkillsDO"] },
    { "tag": "v9", "new_sqlite_classes": ["UserProjectIndexDO", "ProjectAuthorityDO"] },
    { "tag": "v10", "new_sqlite_classes": ["UserMcpConnectionsDO"] },
    { "tag": "v11", "new_sqlite_classes": ["TenantReleasesDO"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
