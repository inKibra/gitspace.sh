{
  "name": "@gitspace/sandbox-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "container:prepare": "bun scripts/prepare-container.ts",
    "dev": "bun run container:prepare && wrangler dev",
    "deploy:dry": "bun run container:prepare && wrangler deploy --dry-run",
    "rollout": "bun scripts/rollout.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9",
    "@gitspace/protocol": "workspace:*",
    "result-rpc": "0.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.16",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  }
}
