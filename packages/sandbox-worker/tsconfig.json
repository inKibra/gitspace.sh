{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "WebWorker"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["./worker-configuration.d.ts", "bun"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
