{
  "name": "gitspace",
  "version": "0.2.0-rc.38",
  "private": true,
  "description": "GitSpace browser workspace, cloud runtime, and machine client",
  "bin": {
    "gitspace": "./bin/gitspace"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/self-develop.ts",
    "demo:move": "bun scripts/move-demo.ts",
    "typecheck": "bun run typecheck:packages",
    "typecheck:packages": "bun run --workspaces --if-present typecheck",
    "test": "bun run test:unit && bun run design:test",
    "test:unit": "bun run test:packages",
    "test:packages": "bun run --filter './packages/*' --filter '!@gitspace/design-tests' --if-present --sequential test",
    "design:lint": "bun run --cwd packages/design-tests lint",
    "design:test": "bun run --cwd packages/design-tests test",
    "design:update-snapshots": "bun run --cwd packages/design-tests test:update",
    "build:web": "bun run --cwd packages/account-web build",
    "build": "bun run build:web && bun run build:gitspace",
    "build:gitspace": "bun run --cwd packages/cli build",
    "check:arch": "bunx --bun depcruise packages/*/src --config .dependency-cruiser.cjs --output-type err",
    "check:product-boundary": "bun scripts/check-product-boundary.ts",
    "typecheck:coverage": "bun scripts/check-typecheck-coverage.ts"
  },
  "keywords": [
    "cli",
    "git",
    "worktree",
    "workspace",
    "terminal",
    "remote",
    "ssh",
    "tui"
  ],
  "homepage": "https://gitspace.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/inKibra/gitspace.sh.git"
  },
  "author": "inKibra, Inc.",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@noble/curves": "^2.2.0",
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.1",
    "@cloudflare/workers-types": "5.20261002.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "dependency-cruiser": "^17.4.3",
    "happy-dom": "^20.11.1",
    "miniflare": "3.20250718.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "typescript": "^5.9.3",
    "ws": "^8.21.1",
    "wrangler": "4.145.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "patchedDependencies": {
    "ghostty-web@0.4.0": "patches/ghostty-web@0.4.0.patch",
    "result-rpc@0.5.0": "packages/protocol/patches/result-rpc@0.5.0.patch"
  },
  "overrides": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0",
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-mcp": "1.0.0",
    "@earendil-works/pi-codemode": "1.0.0",
    "shiki": "4.3.1"
  }
}
