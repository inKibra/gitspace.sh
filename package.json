{
  "name": "gitspace",
  "version": "0.2.0-rc.34",
  "description": "CLI for managing GitHub workspaces with git worktrees and secure remote terminal access",
  "bin": {
    "gssh": "./bin/gssh"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "build:web": "cd web && bun install && bun run build",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "build:npm": "bun scripts/build.ts --npm",
    "relay": "bun src/relay/index.ts",
    "e2e:on-demand": "bash scripts/e2e/run-on-demand.sh"
  },
  "optionalDependencies": {
    "@gitspace/darwin-arm64": "0.2.0-rc.34",
    "@gitspace/darwin-x64": "0.2.0-rc.34",
    "@gitspace/linux-x64": "0.2.0-rc.34",
    "@gitspace/linux-arm64": "0.2.0-rc.34"
  },
  "keywords": [
    "cli",
    "git",
    "worktree",
    "workspace",
    "terminal",
    "remote",
    "ssh",
    "tui"
  ],
  "homepage": "https://gitspace.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/inKibra/gitspace.sh.git"
  },
  "author": "inKibra, Inc.",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@fly/sprites": "0.0.1-rc37",
    "@inquirer/prompts": "^7.10.1",
    "@linear/sdk": "^29.0.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@opentui-ui/toast": "^0.0.5",
    "@opentui/core": "^0.1.77",
    "@opentui/react": "^0.1.77",
    "@scure/bip39": "^2.0.1",
    "@types/ws": "^8.18.1",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "ansi-escapes": "^7.3.0",
    "chalk": "^5.6.2",
    "clipboardy": "^5.2.1",
    "commander": "^12.1.0",
    "conf": "^12.0.0",
    "ghostty-opentui": "^1.3.13",
    "open": "^11.0.0",
    "ora": "^8.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "simple-git": "^3.30.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.8",
    "@types/node": "^20.19.32",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "eslint": "^8.57.1",
    "happy-dom": "^20.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.8"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
