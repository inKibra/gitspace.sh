{
  "name": "gitspace",
  "version": "0.2.0-rc.38",
  "description": "CLI for managing GitHub workspaces with git worktrees and secure remote terminal access",
  "bin": {
    "gssh": "./bin/gssh"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "dev:web": "bun scripts/dev.ts",
    "check:lockfile-sync": "bun scripts/check-lockfile-sync.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "eslint src/",
    "build:web": "cd web && bun install && bun run build",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "build:npm": "bun scripts/build.ts --npm",
    "relay": "bun src/relay/index.ts",
    "e2e:on-demand": "bash scripts/e2e/run-on-demand.sh",
    "check:arch": "node node_modules/.bin/depcruise src --config .dependency-cruiser.cjs --output-type err",
    "check:arch:json": "node node_modules/.bin/depcruise src --config .dependency-cruiser.cjs --output-type json"
  },
  "optionalDependencies": {
    "@gitspace/darwin-arm64": "0.2.0-rc.38",
    "@gitspace/darwin-x64": "0.2.0-rc.38",
    "@gitspace/linux-x64": "0.2.0-rc.38",
    "@gitspace/linux-arm64": "0.2.0-rc.38"
  },
  "keywords": [
    "cli",
    "git",
    "worktree",
    "workspace",
    "terminal",
    "remote",
    "ssh",
    "tui"
  ],
  "homepage": "https://gitspace.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/inKibra/gitspace.sh.git"
  },
  "author": "inKibra, Inc.",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@fly/sprites": "0.0.1-rc37",
    "@inquirer/prompts": "^7.10.1",
    "@linear/sdk": "^80.1.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@oh-my-pi/pi-ai": "14.7.3",
    "@oh-my-pi/pi-coding-agent": "14.7.3",
    "@oh-my-pi/pi-tui": "14.7.3",
    "@opentui-ui/toast": "^0.0.5",
    "@opentui/core": "^0.1.77",
    "@opentui/react": "^0.1.77",
    "@scure/bip39": "^2.0.1",
    "@types/ws": "^8.18.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "ansi-escapes": "^7.3.0",
    "chalk": "^5.6.2",
    "clipboardy": "^5.2.1",
    "commander": "^12.1.0",
    "conf": "^12.0.0",
    "diff": "^8.0.4",
    "dockview": "^6.0.1",
    "dockview-react": "^6.0.1",
    "ghostty-opentui": "^1.3.13",
    "hono": "^4.6.0",
    "open": "^11.0.0",
    "ora": "^8.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "simple-git": "^3.30.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.8",
    "@types/node": "^20.19.32",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260302.1",
    "dependency-cruiser": "^17.3.9",
    "eslint": "^8.57.1",
    "happy-dom": "^20.5.0",
    "miniflare": "^3.20250718.3"
  },
  "engines": {
    "bun": ">=1.3.8"
  },
  "patchedDependencies": {
    "@oh-my-pi/pi-agent-core@14.7.3": "patches/@oh-my-pi%2Fpi-agent-core@14.7.3.patch",
    "@oh-my-pi/pi-coding-agent@14.7.3": "patches/@oh-my-pi%2Fpi-coding-agent@14.7.3.patch",
    "@oh-my-pi/pi-utils@14.7.3": "patches/@oh-my-pi%2Fpi-utils@14.7.3.patch",
    "markit-ai@0.5.3": "patches/markit-ai@0.5.3.patch",
    "@oh-my-pi/pi-natives@14.7.3": "patches/@oh-my-pi%2Fpi-natives@14.7.3.patch"
  }
}
