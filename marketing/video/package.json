{
  "name": "gitspace-marketing-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "bun scripts/gen-audio.ts",
    "vo": "bun tools/serve.ts",
    "render:01": "remotion render src/index.ts ep01-fleet-green ../out/01-fleet-green.mp4 --codec h264",
    "og:01": "remotion still src/index.ts ep01-og ../out/01-og.png",
    "render:01:tok": "remotion render src/index.ts ep01-fleet-green-tok ../out/01-fleet-green-tok.mp4 --codec h264",
    "gif:01": "ffmpeg -y -ss 2.0 -to 15.0 -i ../out/01-fleet-green.mp4 -vf 'fps=15,scale=960:-1:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=128[p];[s1][p]paletteuse=dither=bayer' ../out/01-fleet-green.gif"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.496",
    "@remotion/google-fonts": "^4.0.496",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.496"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "typescript": "5.9.3"
  }
}
